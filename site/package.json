{
  "name": "limelink-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4350",
    "assets": "python3 scripts/prepare-assets.py",
    "build": "npm run assets && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4351",
    "test:browser": "playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "7.4.2",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "wrangler": "4.157.0"
  }
}
