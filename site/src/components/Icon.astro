  gateway: '<rect x="3" y="7" width="18" height="14" rx="4"/><path d="M7 7V3m10 4V3m-10 12h.01M11 15h6"/>',
  check: '<path d="m5 12 4 4L19 6"/>',
  shield: '<path d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6l-9-4Z"/><path d="m8 12 3 3 5-6"/>',
  link: '<path d="m10 13 4-4m-6 6-2 2a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m4 2 2-2a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0"/>',
