---
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import { readFileSync } from 'node:fs';
const manifest=JSON.parse(readFileSync('../docs/brand/image-generation.json','utf8'));
const assets=manifest.assets.map((item:any,index:number)=>({...item,number:index+1,group:index<9?'brand':index<20?'connection':'hardware'}));
const notes:Record<string,string>={
  'brand':'原创品牌与角色设计。材质、字标和应用效果用于视觉评审。',
  'connection':'软件和网关的目标体验示意。尚未发布 App，具体功能按产品阶段推进。',
  'hardware':'未来硬件生活场景候选，尚未立项、制造或上市。'
};
---
<Site title="28 张图，一起看看连接的可能">
  <section class="page-heading"><div class="wrap"><p class="eyebrow">THE LIME LINK GALLERY</p><h1>把连接，放进生活。</h1><p>从一个青柠色的小伙伴，到手机与电脑的默契，再到未来桌边的陪伴。这里是完整的 28 张设计图，一张也不落下。</p></div></section>
  <section class="gallery-section"><div class="wrap">
    <div class="filters" role="group" aria-label="按设计类别筛选"><button class="filter-button" data-filter="all" aria-pressed="true">全部设计</button><button class="filter-button" data-filter="connection" aria-pressed="false">手机 · 电脑 · 网关</button><button class="filter-button" data-filter="hardware" aria-pressed="false">未来硬件</button><button class="filter-button" data-filter="brand" aria-pressed="false">角色与品牌</button><p class="filter-count" aria-live="polite">共 <span>28</span> 张设计图</p></div>
    <div class="gallery-grid">{assets.map((item:any)=><article class="gallery-card" id={item.id} data-group={item.group}>
      <a href={'/resources/'+item.output} aria-label={'查看'+item.title+'原始大图'}><img src={'/images/'+item.id+'.webp'} width={item.actual_size[0]} height={item.actual_size[1]} alt={item.title+'，设计概念图'} loading="lazy"/></a>
      <div class="caption"><span>{String(item.number).padStart(2,'0')} / 28 · {item.group==='hardware'?'未来硬件概念':item.group==='brand'?'品牌设计':'协同体验规划'}</span><a href={'/resources/'+item.output}>查看原图 <Icon name="up" size={12}/></a></div><h2>{item.title}</h2><p>{notes[item.group]}</p>
    </article>)}</div>
    <p class="resource-note">图中设备、界面、连线和场景用于表达设计方向，不代表功能已实现。部分图像把卡片画成图片占位；首个产品目标仍为文本卡片。硬件结构与接口以未来工程评审为准。</p>
  </div></section>
</Site>
<script>
  const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards=document.querySelectorAll<HTMLElement>('.gallery-card');
  const count=document.querySelector('.filter-count span');
  function filter(value:string){
    let visible=0;
    cards.forEach(card=>{card.hidden=value!=='all'&&card.dataset.group!==value;if(!card.hidden)visible++;});
    buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.filter===value)));
    if(count)count.textContent=String(visible);
  }
  buttons.forEach(button=>button.addEventListener('click',()=>filter(button.dataset.filter??'all')));
  const requested=new URLSearchParams(location.search).get('filter');
  if(requested&&['brand','connection','hardware'].includes(requested)&&!location.hash)filter(requested);
  if(location.hash){filter('all');requestAnimationFrame(()=>document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView());}
</script>
