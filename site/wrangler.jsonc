{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "limelink-website",
  "account_id": "2f01018126ee716e5c953470f2aef993",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
